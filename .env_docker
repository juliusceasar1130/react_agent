# database for agent memory
# DATABASE_URL='postgresql://root:root@172.22.44.99:5432/agent_memory'
DATABASE_URL='postgresql://root:root@120JPH_postgres:5432/agent_memory'

# PostgreSQL database for rollerbed tracking system
# ROLLERBED_DATABASE_URL='postgresql://root:root@172.22.44.99:5432/rollerbed_tracking_db'
ROLLERBED_DATABASE_URL='postgresql://root:root@120JPH_postgres:5432/rollerbed_tracking_db'

# PostgreSQL analytics database for SQL Agent business queries
ANALYTICS_DATABASE_URL='postgresql://root:root@120JPH_postgres:5432/analytics_db'
ANALYTICS_DB_SEARCH_PATH='mart,fct,dim,ods,meta,public -ctimezone=Asia/Shanghai'
# ANALYTICS_DB_SEARCH_PATH='mart,fct,dim,ods,meta,public'

# DEBUG: Determines the environment tag for LangSmith Tracing (true -> env:debug, false -> env:prod)
DEBUG="true"

# BACKEND_PORT: The backend service port exposed to the host by docker-compose
BACKEND_PORT='8000'

# agent
AGENT_TEMPERATURE="0.7"
AGENT_MAX_TOKENS="6000"
LLM_TIMEOUT="120"
LLM_MAX_RETRIES="3"
# Qwen3.6 MoE Advanced Sampling (RTX 5090 Local Optimization)
LLM_TOP_P=0.95
LLM_TOP_K=20
LLM_REPETITION_PENALTY=1.0
LLM_PRESENCE_PENALTY=0.0
LLM_MIN_P=0.0
LLM_ENABLE_THINKING=false

# llama.cpp context warning
# [WARNING BYPASS] Temporarily disabled (set to false) to avoid high-frequency HTTP 400 warnings on vLLM backend.
# (vLLM does not natively support llama.cpp's custom /tokenize endpoint)
# Enable this only when the current chat model is served by a real llama.cpp server that exposes /tokenize.
LLM_CONTEXT_WARNING_ENABLED=false
# Full context window used for warning calculations. Keep this aligned with llama-server default:16384
LLM_CONTEXT_WINDOW='16000'
# Warn when a single model call is close to this input-token threshold.
LLM_CONTEXT_WARN_TOKENS='16000'
# Reserve extra tokens for chat template, tool schema, and other hidden overhead.
LLM_CONTEXT_SAFETY_BUFFER='512'
# Base URL for the llama.cpp tokenize endpoint. Do not include /v1 here.
# LLAMA_CPP_TOKENIZE_BASE_URL='http://192.168.3.245:8089'
LLAMA_CPP_TOKENIZE_BASE_URL='http://host.docker.internal:8089'
# Timeout in seconds for the tokenize preflight request.
LLM_CONTEXT_TOKENIZER_TIMEOUT='5'

# docker
POSTGRES_USER='root'
POSTGRES_PASSWORD='root'
POSTGRES_DB='rearch_agent'
POSTGRES_PORT='5432'

# production DB (unused)
MYSQL_DATABASE_URL='mysql+pymysql://root:root@host.docker.internal:3306/mds?charset=utf8mb4'
# SQL Agent soft limit: suggested LIMIT value for LLM-generated SQL
SQL_AGENT_TOP_K='30'
# SQL result hard limit: backend truncation threshold to prevent memory overflow and context bloat
SQL_RESULT_HARD_LIMIT='30'
# Truncation preview rows: number of data rows returned to LLM as a preview when hard limit is hit
SQL_RESULT_PREVIEW_ROWS='5'
# 维度表/字典表白名单，免受严格的 SQL_RESULT_HARD_LIMIT 约束
DIMENSION_TABLES='carrier_types,process_areas,vehicle_body_types,vehicle_color_codes,vehicle_platforms'
# 纯维度表查询时的宽松硬截断上限
DIMENSION_RESULT_HARD_LIMIT='300'
# Temporary directory for generated SQL export files
SQL_EXPORT_DIR='C:\Users\julius\AppData\Local\Temp\sql_agent_exports'
# Expiration time in hours for generated SQL export files
SQL_EXPORT_TTL_HOURS='24'
# Temporary directory for generated chart artifact files
CHART_ARTIFACT_DIR='C:\Users\julius\AppData\Local\Temp\sql_agent_charts'
# Expiration time in hours for generated chart artifact files
CHART_ARTIFACT_TTL_HOURS='24'
# Maximum number of data points allowed in a chart artifact
CHART_ARTIFACT_MAX_POINTS='200'

 # ollama #'qwen3:30b'
 OLLAMA_BASE_URL='http://host.docker.internal:11434'
 OLLAMA_MODEL='qwen3:30b'
 OLLAMA_NUM_CTX='32768'
 OLLAMA_KEEP_ALIVE=-1

 # Ollama embedding model for local RAG
 OLLAMA_EMBED_MODEL='qwen3-embedding:0.6b'

 # Embedding provider for Milvus hybrid retrieval: ollama | llama_cpp
 EMBEDDING_PROVIDER='llama_cpp'
 LLAMA_CPP_EMBED_BASE_URL='http://host.docker.internal:8081'
 LLAMA_CPP_EMBED_MODEL='Qwen/Qwen3-Embedding-0.6B-GGUF:q8_0'
 LLAMA_CPP_EMBED_TIMEOUT='60'
 QWEN_QUERY_INSTRUCTION_ENABLED='true'
 QWEN_QUERY_INSTRUCTION='Given a web search query, retrieve relevant passages that answer the query'



 # graph
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""

# vector
NVIDIA_API_KEY=""

# RAG
# In pure vector mode, it uses cosine similarity;
# in hybrid mode, it uses the fused score from RRF (Reciprocal Rank Fusion).
RAG_BACKEND='milvus_hybrid'
RAG_SIMILARITY_THRESHOLD=0.0

# Milvus hybrid(RAG_BACKEND=milvus_hybrid works)
# for ccr milvus init embedding('http://172.22.44.99:19530')
MILVUS_URI= 'http://milvus-standalone:19530'
MILVUS_COLLECTION_NAME='rag_store'
MILVUS_EMBED_DIM=1024
MILVUS_RRF_K=60
MILVUS_CHUNK_SIZE=512
MILVUS_CHUNK_OVERLAP=50

# Milvus init(load data to Milvus)
MILVUS_DATA_DIR='backend/app/agent/vector/milvus_init/data/examples'
MILVUS_OVERWRITE='true'


# Rerank
RERANK_ENABLED="false"
RERANK_MODEL="nvidia/rerank-qa-mistral-4b"
RERANK_TOP_N="3"
RERANK_SCORE_THRESHOLD="-0.6"
