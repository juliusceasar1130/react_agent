# ==========================================
# System & Environment (系统与服务基础配置)
# ==========================================
BACKEND_PORT='8000'

# DEBUG 调试模式开关：
# 1. 决定 LangSmith 链路追踪标签（true -> env:debug，false -> env:prod）
# 2. 控制系统 Prompt 提示词模板热重载（true 开启改动自动重载，false 开启生产高效率缓存）
DEBUG="true"

# 系统提示词模板文件路径 (支持 DEBUG=true 时热重载)
SYSTEM_PROMPT_PATH='backend/app/agent/prompts/base_system_prompt.md'


# ==========================================
# Databases & Persistence (数据库与持久化)
# ==========================================
# Agent 状态与记忆持久化数据库 (含聊天会话 chat_sessions/messages 与 LangGraph Checkpoint 检查点状态)
DATABASE_URL='postgresql://root:root@120JPH_postgres:5432/agent_memory'

# PostgreSQL 业务分析数据库 (SQL Agent 业务查询)
ANALYTICS_DATABASE_URL='postgresql://root:root@120JPH_postgres:5432/analytics_db'
ANALYTICS_DB_SEARCH_PATH='mart,fct,dim,ods,meta,public -ctimezone=Asia/Shanghai'


# ==========================================
# LLM & Inference (大模型推理引擎配置)
# ==========================================
# vLLM 本地服务端点 (OpenAI 兼容接口)
DEEPSEEK_API_KEY='sk-no-key-required'
DEEPSEEK_MODEL='gpt-5-nano'
DEEPSEEK_BASE_URL='http://host.docker.internal:8089/v1'

# DEEPSEEK_API_KEY='sk-no-key-required'
# DEEPSEEK_MODEL='gpt-5-nano'
# DEEPSEEK_BASE_URL='http://192.168.3.17:8089/v1'

AGENT_TEMPERATURE="0.7"
AGENT_MAX_TOKENS="6000"
LLM_TIMEOUT="120"
LLM_MAX_RETRIES="3"

# Qwen3.6 MoE 高级采样参数 (RTX 5090 本地优化)
LLM_TOP_P=0.95
LLM_TOP_K=20
LLM_REPETITION_PENALTY=1.0
LLM_PRESENCE_PENALTY=0.0
LLM_MIN_P=0.0
LLM_ENABLE_THINKING=true


# ==========================================
# Context & Tokenizer (上下文管理与 Token 估算预警)
# ==========================================
# Tokenizer 引擎选择: 'vllm' 或 'llama_cpp'
TOKEN_ESTIMATOR_ENGINE="vllm"

# LLM 上下文预警机制开关
LLM_CONTEXT_WARNING_ENABLED=true
LLM_CONTEXT_WINDOW='25000'
LLM_CONTEXT_WARN_TOKENS='25000'
LLM_CONTEXT_SUMMARIZE_TRIGGER_TOKENS='20000'
LLM_CONTEXT_SAFETY_BUFFER='1000'
LLM_CONTEXT_TOKENIZER_TIMEOUT='2'
LLM_CONTEXT_COLLAPSE_PROTECT_TURNS='3'
LLM_CONTEXT_REDACTION_KEEP_COUNT='3'

# LLAMA_CPP TOKENIZE 端点 (用于 TOKEN_ESTIMATOR_ENGINE="llama_cpp")
LLAMA_CPP_TOKENIZE_BASE_URL='http://host.docker.internal:8089'

# VLLM TOKENIZE 端点 (用于 TOKEN_ESTIMATOR_ENGINE="vllm")
VLLM_TOKENIZE_BASE_URL="http://host.docker.internal:8089"
# VLLM_TOKENIZE_BASE_URL="http://192.168.3.17:8089"
VLLM_TOKENIZE_MODEL='gpt-5-nano'


# ==========================================
# Agent Call Limits & Guardrails (Agent 调用限制与防死循环)
# ==========================================
# ModelCallLimitMiddleware: 单次对话中模型调用总次数上限（含推理+工具响应后再推理）
AGENT_MODEL_CALL_RUN_LIMIT="40"
# ToolCallLimitMiddleware: 单次对话中工具调用总次数上限
AGENT_TOOL_CALL_RUN_LIMIT="40"
# 超限后行为: 'end' = 优雅结束并总结已知信息, 'error' = 抛出异常
AGENT_CALL_LIMIT_EXIT_BEHAVIOR="end"


# ==========================================
# SQL Execution & Result Limits (SQL 查询与导出限制)
# ==========================================
# SQL Checker 模式：fast (仅本地 Linter 检查) | safety (本地 Linter + 大模型 Checker)
SQL_CHECKER_MODE="fast"

# SQL Agent 建议 LIMIT 限制
SQL_AGENT_TOP_K='1000'

# SQL 结果硬截断限制 (防止内存溢出) 与预览行数
SQL_RESULT_HARD_LIMIT='30'
SQL_RESULT_PREVIEW_ROWS='5'

# 维度表/字典表白名单及其宽松截断上限
DIMENSION_TABLES='carrier_types,process_areas,vehicle_body_types,vehicle_color_codes,vehicle_platforms'
DIMENSION_RESULT_HARD_LIMIT='300'

# 统一工件存储底座 (图表自动存入 charts/，CSV 自动存入 exports/) 与生命周期
ARTIFACTS_DIR='/tmp/sql_agent_artifacts'
ARTIFACTS_TTL_HOURS='24'

# SQL 导出与图表业务硬上限保护
SQL_EXPORT_MAX_ROWS='100000'
CHART_ARTIFACT_MAX_POINTS='200'


# ==========================================
# RAG & Vector Search (RAG 检索、Milvus 与 Embedding 向量配置)
# ==========================================
# RAG 检索后端模式 (milvus_hybrid | pgvector)
RAG_BACKEND='milvus_hybrid'
RAG_SIMILARITY_THRESHOLD=0.0

# Embedding 提供商 (llama_cpp | ollama)
EMBEDDING_PROVIDER='llama_cpp'
LLAMA_CPP_EMBED_BASE_URL='http://host.docker.internal:8081'
LLAMA_CPP_EMBED_MODEL='Qwen/Qwen3-Embedding-0.6B-GGUF:q8_0'
LLAMA_CPP_EMBED_TIMEOUT='60'
QWEN_QUERY_INSTRUCTION_ENABLED='true'
QWEN_QUERY_INSTRUCTION='Given a web search query, retrieve relevant passages that answer the query'

# Milvus 混合检索配置 'http://127.0.0.1:19530'
MILVUS_URI='http://milvus-standalone:19530'
MILVUS_COLLECTION_NAME='rag_store'
MILVUS_EMBED_DIM=1024
MILVUS_RRF_K=60
MILVUS_CHUNK_SIZE=1024
MILVUS_CHUNK_OVERLAP=50
MILVUS_DATA_DIR='backend/app/agent/vector/milvus_init/data/examples'
MILVUS_OVERWRITE='true'

# 数据库物理三层词典配置 (table_schema_store/db_value_lexicon/db_row_lexicon)
DB_LEXICON_SYNC_ON_STARTUP="false"
LEXICON_SIMILARITY_TOP_K='5'
LEXICON_SCHEMA_TOP_K=3
LEXICON_VALUE_TOP_K=5
LEXICON_ROW_TOP_K=2

# 重排序 Rerank 配置
RERANK_ENABLED="false"
RERANK_MODEL="nvidia/rerank-qa-mistral-4b"
RERANK_TOP_N="3"
RERANK_SCORE_THRESHOLD="-0.6"


# ==========================================
# Rule Extractor (案例自演进规则提取器)
# ==========================================
RULE_EXTRACTOR_SAFETY_ENABLED="true"
RULE_EXTRACTOR_SAFETY_BLOCKED_KEYWORDS="DROP,DELETE,TRUNCATE,UPDATE,INSERT,GRANT"
RULE_EXTRACTOR_SAFETY_WARNING_MARKERS="SAFETY WARNING,BLOCKED BY SECURITY FILTER,PERMISSION DENIED"
RULE_EXTRACTOR_EMPTY_RESULT_ENABLED="true"
RULE_EXTRACTOR_SINGLE_SQL_ENABLED="false"
RULE_EXTRACTOR_BACKTRACK_ENABLED="true"
RULE_EXTRACTOR_BACKTRACK_MAX_TURNS="3"
RULE_EXTRACTOR_DOMAIN_ENABLED="true"
RULE_EXTRACTOR_MAX_SQL_STEPS="3"


# ==========================================
# SQL Linter & Guardrails (SQL 规则拦截工具箱)
# ==========================================
# 是否启用 SQL 执行前的静态与语义合规 linter 拦截工具 (true/false)
SQL_LINTER_ENABLED="true"
# 嵌套子查询的最大嵌套深度上限限制 (超过则抛出 ERROR 拦截并触发 Agent 自愈)
SQL_LINTER_MAX_SUBQUERY_DEPTH="3"
# 允许定义的最大 CTE 数量限制 (超过将触发 WARNING 警告)
SQL_LINTER_MAX_CTE_COUNT="3"
# 允许访问的数据库 schema 白名单模式列表 (逗号分隔，跨库/非白名单则 ERROR 拦截)
SQL_LINTER_ALLOWED_SCHEMAS="mart,fct,dim,ods,meta,public"
# 规则严重度重置覆盖映射 (格式如 RULE_ID:SEVERITY)
SQL_LINTER_RULES_SEVERITY_OVERRIDE=""
# 禁用的校验规则 ID 列表
SQL_LINTER_DISABLED_RULES="STR-002"


# ==========================================
# Tracing & Telemetry (LangSmith 观察与追踪)
# ==========================================
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
